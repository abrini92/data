# Copy to .env and adjust. No real secrets belong in the repo.

# Default: SQLite (works on Windows without Docker).
# For Postgres via docker compose, use the postgresql URL below instead.
DATABASE_URL=sqlite:///./data/dataia.db
# DATABASE_URL=postgresql+psycopg://dataia:dataia@localhost:5432/dataia

# PostgreSQL (docker-compose defaults) — only needed if using Postgres
POSTGRES_USER=dataia
POSTGRES_PASSWORD=dataia
POSTGRES_DB=dataia
POSTGRES_PORT=5432

# LLM provider: stub | openai | azure (stub = offline / tests; no external calls)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=stub-deterministic

# Pipeline
# Real HTTP collection is OFF by default; Collector uses stub documents.
COLLECT_REAL_SOURCES=false
EXTRACTOR_VERSION=0.1.0
SCHEDULER_ENABLED=false

# Dashboard
DASHBOARD_PORT=8501
