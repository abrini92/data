# Copy to .env and adjust. No real secrets belong in the repo.

# Default: SQLite (works on Windows without Docker).
# For Postgres via docker compose, use the postgresql URL below instead.
DATABASE_URL=sqlite:///./data/dataia.db
# DATABASE_URL=postgresql+psycopg://dataia:dataia@localhost:5432/dataia

# PostgreSQL (docker-compose defaults) — only needed if using Postgres
POSTGRES_USER=dataia
POSTGRES_PASSWORD=dataia
POSTGRES_DB=dataia
POSTGRES_PORT=5432

# LLM provider: stub | openai | azure (stub = offline / tests; no external calls)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=stub-deterministic

# Pipeline
# Real HTTP collection is OFF by default; Collector / connectors use fixtures or stubs.
COLLECT_REAL_SOURCES=false
# Synthetic resolved set / source-error history OFF by default.
# Hard error if COLLECT_REAL_SOURCES=true AND USE_SYNTHETIC=true.
USE_SYNTHETIC=false
EXTRACTOR_VERSION=0.1.0
SCHEDULER_ENABLED=false
BRIER_MIN_N=30
CMA_TIMEOUT_SECONDS=15

# Optional API keys for live connectors (never commit real values)
EIA_API_KEY=
GASTAT_API_KEY=

# Paths (defaults: ILLUSTRATIVE KSA macro seed until non-oil tree lands)
# SEED_PATH=seeds/ksa_macro_2026.yaml
# TAXONOMY_PATH=config/taxonomy.yaml
# PRIOR_MAPPING_PATH=config/prior_mapping.yaml
# Target question (empty tree → not ready):
# SEED_PATH=seeds/ksa_nonoil_growth_2027.yaml
# Optional Starlink example:
# SEED_PATH=seeds/starlink_ksa.yaml
# TAXONOMY_PATH=config/taxonomy_starlink.yaml

# Dashboard (Streamlit legacy)
DASHBOARD_PORT=8501

# Platform UI (BRIEF-5) — empty / fake placeholders only; never commit real secrets
# DATAIA_ENV=test
# DATAIA_UI_HOST=127.0.0.1
# DATAIA_UI_PORT=8520
# DATAIA_UI_SECRET_KEY=
# DATAIA_UI_USERS_PATH=
# DATAIA_UI_SESSION_MINUTES=480
# DATAIA_UI_DEFAULT_LOCALE=en
# DATAIA_UI_DATABASE_URL=
# DATAIA_UI_TEST_DB_PATH=data/test/dataia.db
# REGISTRY_CHAIN_HEAD_PATH=data/registry_chain_head.jsonl
# FREEZE_CALENDAR_PATH=config/freeze_calendar.yaml
